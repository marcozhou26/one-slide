{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single Consulting Slide Page Intent Model",
  "type": "object",
  "required": ["version", "audience", "subject", "story", "expression_method", "information_skeleton", "visual_consequence"],
  "properties": {
    "version": { "const": "2.0" },
    "audience": {
      "type": "object",
      "required": ["reader", "task"],
      "properties": {
        "reader": { "type": "string", "minLength": 1 },
        "task": { "type": "string", "minLength": 1 }
      }
    },
    "subject": { "$ref": "#/$defs/sourcedText" },
    "story": { "$ref": "#/$defs/sourcedText" },
    "expression_method": { "type": "string", "minLength": 1 },
    "information_skeleton": {
      "type": "object",
      "required": ["entities", "fields", "relationships"],
      "properties": {
        "entities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourcedItem" } },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }
      }
    },
    "visual_consequence": {
      "type": "object",
      "required": ["primary_evidence", "regions", "alignment_axes", "layers"],
      "properties": {
        "primary_evidence": { "type": "string", "minLength": 1 },
        "regions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "role", "weight"], "properties": { "id": { "type": "string" }, "role": { "type": "string" }, "weight": { "type": "number", "exclusiveMinimum": 0 } } },
        "alignment_axes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "layers": { "type": "array", "minItems": 3, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "sourcedText": { "type": "object", "required": ["text", "source_ids"], "properties": { "text": { "type": "string", "minLength": 1 }, "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
    "sourcedItem": { "type": "object", "required": ["id", "label", "source_ids"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
    "field": { "type": "object", "required": ["field_id", "label", "value_type", "alignment", "axis_id", "source_ids"], "properties": { "field_id": { "type": "string" }, "label": { "type": "string" }, "value_type": { "enum": ["text", "number", "percentage", "currency", "date", "duration", "rating", "status"] }, "alignment": { "enum": ["left", "center", "right"] }, "axis_id": { "type": "string" }, "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
    "relationship": { "type": "object", "required": ["type", "from", "to", "source_ids"], "properties": { "type": { "enum": ["sequence", "cause", "dependency", "membership", "same_entity_across_time", "flow", "annotation"] }, "from": { "type": "string" }, "to": { "type": "string" }, "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
  }
}
